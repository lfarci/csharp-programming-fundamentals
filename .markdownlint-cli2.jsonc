{
  // Rules tuned for beginner course content. See AGENTS.md "Checks".
  "config": {
    "default": true,
    "MD013": false,          // long lines: prose and tables stay on one line
    "MD033": { "allowed_elements": ["details", "summary", "br", "kbd", "ProgressPage", "ThemeExercises", "ExercisesOverview", "div", "video", "source", "RoadmapPath", "MsLearnPath", "VideoGallery", "LearnFlow", "p", "a", "ProgressSummary", "ExerciseHeader", "ThemeGroups", "LearnCard", "DrillSets", "CardList"] },
    "MD038": false,          // `N: ` prompts need a trailing space inside code
    "MD041": false,          // pages open with a breadcrumb line, then the H1
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".vitepress/**", "**/bin/**", "**/obj/**"]
}

# Diagram source. Render: tools/diagrams.sh
...@_style
direction: down

A: "boxes: count = 0, sum = 0" {class: step}
B: "read a value" {class: step}
C: "value == 0 ?\n(sentinel)" {class: ask}
E: "stop: use the boxes" {class: step}
D: "count++\nsum += value" {class: step}

A -> B
B -> C
C -> E: "yes"
C -> D: "no"
D -> B

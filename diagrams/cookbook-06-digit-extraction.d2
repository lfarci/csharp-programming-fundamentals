# Diagram source. Render: tools/diagrams.sh
...@_style
direction: down

A: "remaining = n\n(work on a COPY)" {class: step}
B: "remaining > 0 ?" {class: ask}
C: "digit = remaining % 10" {class: step}
D: "use digit\n(count it, add it, …)" {class: step}
E: "remaining = remaining / 10" {class: step}
F: "use the result" {class: step}

A -> B
B -> C: "yes"
C -> D
D -> E
E -> B
B -> F: "no"

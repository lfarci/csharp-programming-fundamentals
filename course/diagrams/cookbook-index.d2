# How to pick a recipe: ask the questions from top to bottom; the first yes wins. Render: internal/tools/diagrams.sh
...@_style
grid-rows: 10
grid-columns: 2
horizontal-gap: 70
vertical-gap: 16

q1: "A picture of rows and columns?" {class: ask; width: 360}
r1: "8. Nested loops" {class: step; width: 400}
q2: "Read input until it is OK?" {class: ask; width: 360}
r2: "9. Input validation" {class: step; width: 400}
q3: "Values come until a stop value?" {class: ask; width: 360}
r3: "10. Sentinel loop + a recipe below" {class: step; width: 400}
q4: "Work on the digits of a number?" {class: ask; width: 360}
r4: "6. Digit extraction + a recipe below" {class: step; width: 400}
q5: "Next value depends on the last ones?" {class: ask; width: 360}
r5: "7. State update" {class: step; width: 400}
q6: "A list of values to print?" {class: ask; width: 360}
r6: "1. Counter loop" {class: step; width: 400}
q7: "One total, count or product?" {class: ask; width: 360}
r7: "2. Accumulator (3. if only some values)" {class: step; width: 400}
q8: "The biggest or the smallest?" {class: ask; width: 360}
r8: "4. Min / max" {class: step; width: 400}
q9: "Yes or no, or a position?" {class: ask; width: 360}
r9: "5. Flag / search" {class: step; width: 400}
q10: "A new text?" {class: ask; width: 360}
r10: "12. Build a string" {class: step; width: 400}

q1 -> r1: yes
q2 -> r2: yes
q3 -> r3: yes
q4 -> r4: yes
q5 -> r5: yes
q6 -> r6: yes
q7 -> r7: yes
q8 -> r8: yes
q9 -> r9: yes
q10 -> r10: yes

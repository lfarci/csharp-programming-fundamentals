# How one exercise goes, from start to DONE. Render: internal/tools/diagrams.sh
...@_style
direction: right

read: "1. Read the exercise\nand trace an example on paper" {class: step}
start: "2. ./ex start A04\nopens your file" {class: step}
code: "3. Write the code\nin VS Code" {class: step}
check: "4. ./ex check" {class: ask}
done: "DONE\nthen ./ex next" {class: end}
hint: "Read the NOT YET message,\nopen one hint" {class: note}

read -> start -> code -> check
check -> done: "all OK"
check -> hint: "NOT YET"
hint -> code

# Diagram source. Render: internal/tools/diagrams.sh
...@_style
direction: down

N: "n = 153" {class: step}
STEP1: "STEP1" {class: step}
C1: "digits = 3" {class: step}
STEP2: "STEP2" {class: step}
D1: "digit = 3, then 5, then 1" {class: step}
P1: "power = digit × digit × digit" {class: step}
STEP3: "STEP3" {class: step}
STEP4: "STEP4" {class: step}
S1: "sum = 27 + 125 + 1 = 153" {class: step}
STEP5: "⑤ Compare\nsum == n ?" {class: ask}
Y: "Armstrong " {class: step}
X: "not Armstrong " {class: step}

N -> STEP1
STEP1 -> STEP2
D1 -> STEP3
STEP2 -> STEP4
STEP4 -> STEP5
STEP5 -> Y: "yes"
STEP5 -> X: "no"
